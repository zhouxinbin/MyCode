   "source": [
    "import torch\n",
    "from torch import nn\n",
    "\n",
    "class My_nn(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "    \n",
    "    def forward(self, input):\n",
    "        return input + 1\n",
    "\n",
    "\n",
    "my_nn = My_nn()\n",
    "x = torch.tensor(1) # 张量\n",
    "output = my_nn(x) # 前向传播\n",
    "print(output)\n"
   ]
  },
